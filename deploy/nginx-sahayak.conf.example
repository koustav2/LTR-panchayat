# nginx server block for the Sahayak portal.
#
#   sudo cp deploy/nginx-sahayak.conf.example /etc/nginx/sites-available/sahayak
#   sudo nano /etc/nginx/sites-available/sahayak      # set your domain
#   sudo ln -s /etc/nginx/sites-available/sahayak /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then add TLS:
#   sudo certbot --nginx -d lrt.truehr.co.in
#
# certbot rewrites this file to add the 443 block and the redirect. Nothing
# here touches any other site on the server.

server {
    listen 80;
    listen [::]:80;
    server_name lrt.truehr.co.in;          # <-- change this

    # Uploads travel through here: 5 MB per file plus multipart overhead.
    client_max_body_size 12M;

    access_log /var/log/nginx/sahayak.access.log;
    error_log  /var/log/nginx/sahayak.error.log;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
